{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zasady.html",
      "destination": "/zasady",
      "permanent": true
    },
    {
      "source": "/zacznij",
      "destination": "/zacznij-grac",
      "permanent": true
    },
    {
      "source": "/kontakt.html",
      "destination": "/lekcje",
      "permanent": true
    },
    {
      "source": "/wydarzenia.html",
      "destination": "/aktualnosci",
      "permanent": true
    },
    {
      "source": "/galeria.html",
      "destination": "/aktualnosci",
      "permanent": true
    },
    {
      "source": "/kontakt",
      "destination": "/lekcje",
      "permanent": true
    },
    {
      "source": "/en/kontakt",
      "destination": "/en/lekcje",
      "permanent": true
    },
    {
      "source": "/uk/kontakt",
      "destination": "/uk/lekcje",
      "permanent": true
    }
  ]
}
